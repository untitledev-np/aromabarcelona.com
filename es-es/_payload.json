[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"$RcJmAH4yb5":3,"$2XHn5G0dnE":81},{"id":4,"title":5,"body":6,"description":13,"extension":14,"meta":15,"navigation":76,"path":77,"seo":78,"stem":79,"__hash__":80},"content/es-es/index.md","Inicio",{"type":7,"value":8,"toc":9},"minimark",[],{"title":10,"searchDepth":11,"depth":11,"links":12},"",2,[],"Disfruta de la auténtica cocina india en el corazón de Barcelona","md",{"commingSoon":16,"heroSection":20,"aboutSection":26,"gallerySection":30,"multimediaText":36,"location":49,"order":57,"footer":60},{"title":17,"description":18,"image":19},"Próximamente","Estamos trabajando duro para ofrecerte una experiencia increíble. ¡Mantente atento a algo muy especial!","/images/aromo-logo.png",{"title":21,"description":22,"image":23,"orderCta":24,"reserveCta":25},"Sabores Eternos, Elegancia Moderna","Saborea los auténticos sabores de la India en un ambiente cálido y acogedor.","/images/hero.jpg,","Pedir","Reserva",{"title":27,"description":28,"image":29},"Sobre Aroma Barcelona","Aroma Barcelona trae las ricas tradiciones culinarias de la India a las vibrantes calles de Barcelona. Nuestros chefs expertos elaboran cada plato con especias auténticas e ingredientes frescos, ofreciéndote una experiencia genuina de hospitalidad y sabor indio.","/images/gallery/7.jpg",{"images":31},[29,32,33,34,35],"/images/gallery/2.jpg","/images/gallery/5.jpg","/images/gallery/3.jpg","/images/gallery/4.jpg",[37,43],{"videoSrc":38,"videoPoster":39,"title":40,"description":41,"textPosition":42},"/videos/food.mp4","/images/poste-2.jpg","Tandoor Naan y Sabores Intensos","Observa cómo nuestros chefs estiran a mano el pan naan fresco y lo introducen en el ardiente tandoor, mientras los aromáticos curris hierven con ricas especias. Cada bocado es una explosión de auténtico sabor indio.","left",{"videoSrc":44,"videoPoster":45,"title":46,"description":47,"textPosition":48},"/videos/ambinete.mp4","/images/poster-3.jpg","Un Ambiente Elegante para Momentos Memorables","Entra en nuestro espacioso y luminoso comedor, perfecto para almuerzos tranquilos, cenas de celebración o eventos en grupo. Tonos cálidos, detalles contemporáneos indios y amplios asientos crean un entorno acogedor donde cada comida se siente especial.","right",{"title":50,"openingHours":51,"address":54,"phone":55,"mapUrl":56},"Visítanos",{"Lunes":52,"Martes":53,"Miércoles":53,"Jueves":53,"Viernes":53,"Sábado":53,"Domingo":53},"Cerrado","12:00 pm - 11:30 pm","Carrer del Comandant Benítez, 31, Les Corts, 08028 Barcelona","935322458","https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11720.695112309118!2d2.118016341721499!3d41.373576129132566!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a499006783e311%3A0x7689f9a11608b256!2sAroma%20Indian%20Restaurant!5e1!3m2!1sen!2ses!4v1760786828547!5m2!1sen!2ses",{"title":58,"description":59,"image":32},"Pide Ahora","Pide tu orden ahora y la recibiras en tu puerta.",{"restaurant":61,"quickLinks":63,"contact":68,"legal":71},{"name":62,"tagline":13},"Aroma Indian Restaurant",{"title":64,"home":5,"menu":65,"about":66,"contact":67},"Enlaces Rápidos","Menú","Sobre Nosotros","Contacto",{"title":69,"phone":70,"address":54},"Contáctanos","+34 935 322 458",{"copyright":72,"terms":73,"privacy":74,"sitemap":75},"Todos los derechos reservados.","Términos y Condiciones","Política de Privacidad","Mapa del Sitio",true,"/es-es",{"title":5,"description":13},"es-es/index","xgVeBHfl3TdWNsL-1bdbZwAs9SelS4zA7XxisvuQAF4",{"id":4,"title":5,"body":82,"description":13,"extension":14,"meta":86,"navigation":76,"path":77,"seo":103,"stem":79,"__hash__":80},{"type":7,"value":83,"toc":84},[],{"title":10,"searchDepth":11,"depth":11,"links":85},[],{"commingSoon":87,"heroSection":88,"aboutSection":89,"gallerySection":90,"multimediaText":92,"location":95,"order":97,"footer":98},{"title":17,"description":18,"image":19},{"title":21,"description":22,"image":23,"orderCta":24,"reserveCta":25},{"title":27,"description":28,"image":29},{"images":91}